{
  "name": "file-organizer",
  "version": "1.0.0",
  "description": "CLI tool to analyze, deduplicate, organize and clean up directories",
  "type": "module",
  "main": "file-organizer.js",
  "bin": {
    "file-organizer": "./file-organizer.js"
  },
  "scripts": {
